{
    "version": 1,
    "hooks": {
        "afterAgentResponse": [
            {
                "command": "node .cursor/hooks/detect-json-wrapper.mjs --hook"
            }
        ],
        "stop": [
            {
                "command": "node .cursor/hooks/wrapped-output-guard.mjs --stop",
                "loop_limit": 2
            }
        ],
        "preToolUse": [
            {
                "matcher": "Write|StrReplace|Delete",
                "command": "node .cursor/hooks/write-gate.mjs",
                "failClosed": true
            }
        ]
    }
}
