# Dev defaults only. Copy to deploy/env/dev.env and edit; never commit runtime env files.
ESO_ENV=dev
ESO_IMAGE_TAG=dev
ESO_DB_NAME=eso
ESO_DB_USER=eso
ESO_DB_PASSWORD=eso-dev-only-password
ESO_DB_PORT=5432
ESO_API_PORT=8787
ESO_UI_PORT=4200
ESO_AUTH_TOKEN=eso-dev-only-token
ESO_AUTH_PROJECT=eso
ESO_HEALTH_TIMEOUT=120
ESO_LOG_TAIL=200
ESO_BACKUP_KEEP=14

# Optional: root for the host-native directory browser; defaults to $HOME.
# ESO_FS_ROOT=/Users/example
