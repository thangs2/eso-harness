# Production template. Copy to deploy/env/prod.env and replace every CHANGE_ME placeholder.
ESO_ENV=prod
ESO_IMAGE_TAG=CHANGE_ME
ESO_REGISTRY=ghcr.io/example-org
ESO_DB_NAME=eso
ESO_DB_USER=eso
ESO_DB_PASSWORD=CHANGE_ME
ESO_DB_PORT=5432
ESO_API_PORT=8787
ESO_UI_PORT=4200
ESO_AUTH_TOKEN=CHANGE_ME
ESO_AUTH_PROJECT=eso
ESO_HEALTH_TIMEOUT=120
ESO_LOG_TAIL=200
ESO_BACKUP_KEEP=14
