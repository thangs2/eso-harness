# docgraph.scope — SINGLE SOURCE OF TRUTH for what docgraph covers in eso-harness.
#
# Lives at REPO ROOT and is TRACKED in git.
# Discovered by: walking up from cwd for docgraph.scope, or $DOCGRAPH_REPO.

# --- Extensions -------------------------------------------------------------
ext:.md
ext:.mdc
ext:.json

# --- Documentation pack -----------------------------------------------------
# Repo này không có docs/ (D-108 điều 8): tài liệu bền sống trong sdlc/.

# --- Agent law & skills -----------------------------------------------------
# Nguồn duy nhất là agents/; .cursor/ và .agents/ là bản sinh ra nên KHÔNG index lại
# (nếu index cả hai, mỗi rule hiện hai lần trong kết quả tìm kiếm).
path:AGENTS.md
path:agents

# --- SDLC artifacts ---------------------------------------------------------
path:sdlc

# --- Exclusions -------------------------------------------------------------
exclude:**/tsconfig*.json
exclude:**/package-lock.json
exclude:**/bun.lock
exclude:**/bun.lockb
exclude:node_modules/**
exclude:.harness/**
exclude:.docgraph/**
exclude:.codegraph/**
