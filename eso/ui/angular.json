{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "projects": {
    "control-plane": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "apps/control-plane/src",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "index": "src/index.html",
            "tsConfig": "tsconfig.json",
            "styles": [
              "node_modules/@foblex/flow/styles/default.scss",
              "@angular/material/prebuilt-themes/azure-blue.css",
              "src/styles.css"
            ],
            "assets": [
              {
                "glob": "**/*",
                "input": "public",
                "output": "assets"
              }
            ]
          },
          "configurations": {
            "production": {
              "outputHashing": "all",
              "optimization": true,
              "budgets": [
                {
                  // host placement/observation UI: Hosts grouped runtimes, placement, observation timeline and catalogs.
                  "type": "initial",
                  "maximumWarning": "600kB",
                  "maximumError": "650kB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "8kB",
                  "maximumError": "16kB"
                }
              ]
            },
            "development": {
              "optimization": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "control-plane:build:production"
            },
            "development": {
              "buildTarget": "control-plane:build:development"
            }
          },
          "defaultConfiguration": "development"
        }
      }
    }
  },
  "cli": {
    "analytics": false
  }
}
